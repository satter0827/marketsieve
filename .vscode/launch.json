{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: CLI Command (Prompt for Arguments)",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_cli",
      "args": "${command:pickArgs}",
      "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"},
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: Prepare ChatGPT Request",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_cli",
      "args": ["ai", "prepare", "report", "latest"],
      "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"},
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: Import ChatGPT Response",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_cli",
      "args": ["ai", "import", "${input:aiResponsePath}"],
      "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"},
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "aiResponsePath",
      "type": "promptString",
      "description": "Absolute path to the saved ChatGPT response JSON"
    }
  ]
}
