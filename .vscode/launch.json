{
  "version": "0.2.0",
  "configurations": [
    {"name": "01 First Run: Create Configuration", "type": "node-terminal", "request": "launch", "command": "make setup-config", "cwd": "${workspaceFolder}"},
    {"name": "02 First Run: Import Rakuten Portfolio", "type": "node-terminal", "request": "launch", "command": "make portfolio-import BROKER=rakuten", "cwd": "${workspaceFolder}", "env": {"PORTFOLIO": "${input:portfolioPath}"}},
    {"name": "03 Daily Use: Check Readiness", "type": "node-terminal", "request": "launch", "command": "make daily-status", "cwd": "${workspaceFolder}"},
    {"name": "10 Discovery: Refresh JP Candidates (Network)", "type": "node-terminal", "request": "launch", "command": "make screen-refresh-jp", "cwd": "${workspaceFolder}"},
    {"name": "20 Discovery: Refresh US Candidates (Network)", "type": "node-terminal", "request": "launch", "command": "make screen-refresh-us", "cwd": "${workspaceFolder}"},
    {"name": "30 Watchlist: Add Instrument", "type": "node-terminal", "request": "launch", "command": "make watchlist-add", "cwd": "${workspaceFolder}", "env": {"INSTRUMENT": "${input:instrument}"}},
    {"name": "40 Daily Use: Analyze JP Watchlist (Network)", "type": "node-terminal", "request": "launch", "command": "make daily-jp", "cwd": "${workspaceFolder}"},
    {"name": "50 Daily Use: Analyze US Watchlist (Network)", "type": "node-terminal", "request": "launch", "command": "make daily-us", "cwd": "${workspaceFolder}"},
    {"name": "60 Weekly Use: Build Brief", "type": "node-terminal", "request": "launch", "command": "make weekly", "cwd": "${workspaceFolder}"},
    {"name": "70 Analysis: Build Workspace", "type": "node-terminal", "request": "launch", "command": "make analysis-build", "cwd": "${workspaceFolder}"},
    {"name": "80 Analysis: Show Workspace", "type": "node-terminal", "request": "launch", "command": "make analysis-show", "cwd": "${workspaceFolder}"},
    {"name": "90 Debug: CLI Command", "type": "debugpy", "request": "launch", "module": "marketsieve_cli", "args": "${command:pickArgs}", "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"}, "console": "integratedTerminal", "justMyCode": true},
    {"name": "91 Debug: JP Daily Analysis", "type": "debugpy", "request": "launch", "module": "marketsieve_cli", "args": ["--config", "marketsieve.toml", "daily", "jp"], "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"}, "console": "integratedTerminal", "justMyCode": true},
    {"name": "92 Debug: Analysis Workspace Build", "type": "debugpy", "request": "launch", "module": "marketsieve_cli", "args": ["analysis", "build"], "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"}, "console": "integratedTerminal", "justMyCode": true}
  ],
  "inputs": [
    {"id": "portfolioPath", "type": "promptString", "description": "Absolute path to the Rakuten assetbalance(all) CSV"},
    {"id": "instrument", "type": "promptString", "description": "Instrument in MIC:SYMBOL form", "default": "XTKS:7203"}
  ]
}
