{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App: Doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_app",
      "args": [
        "doctor"
      ],
      "env": {
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "App: Report",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_app",
      "args": [
        "report",
        "--market",
        "all",
        "--output",
        "rich"
      ],
      "env": {
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "App: Report JSON",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_app",
      "args": [
        "report",
        "--market",
        "all",
        "--output",
        "json"
      ],
      "env": {
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
