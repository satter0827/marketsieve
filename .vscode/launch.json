{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "01 First Run: Create Configuration",
      "type": "node-terminal",
      "request": "launch",
      "command": "make setup-config",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "02 First Run: Import Portfolio CSV",
      "type": "node-terminal",
      "request": "launch",
      "command": "make portfolio-import",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORTFOLIO": "${input:portfolioPath}"
      }
    },
    {
      "name": "03 First Run: Check Readiness",
      "type": "node-terminal",
      "request": "launch",
      "command": "make daily-status",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "10 Daily: Analyze JP Close and Prepare ChatGPT Request (Network)",
      "type": "node-terminal",
      "request": "launch",
      "command": "make daily-jp-ai",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "20 Daily: Analyze US Close and Prepare ChatGPT Request (Network)",
      "type": "node-terminal",
      "request": "launch",
      "command": "make daily-us-ai",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "30 Weekly: Build Brief and Prepare ChatGPT Request (After JP and US)",
      "type": "node-terminal",
      "request": "launch",
      "command": "make weekly-ai",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "40 ChatGPT: Import Saved Response and Show Explanation",
      "type": "node-terminal",
      "request": "launch",
      "command": "make ai-import-show",
      "cwd": "${workspaceFolder}",
      "env": {
        "RESPONSE": "${input:aiResponsePath}",
        "CONTROLLED": "${input:aiControlled}"
      }
    },
    {
      "name": "Advanced: Debug CLI Command",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_cli",
      "args": "${command:pickArgs}",
      "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"},
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Advanced: Debug ChatGPT Request Preparation (Existing Report Required)",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_cli",
      "args": ["ai", "prepare", "report", "latest"],
      "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"},
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Advanced: Debug ChatGPT Response Import",
      "type": "debugpy",
      "request": "launch",
      "module": "marketsieve_cli",
      "args": ["ai", "import", "${input:aiResponsePath}"],
      "env": {"PYTHONPYCACHEPREFIX": "${workspaceFolder}/.marketsieve/cache/python"},
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "portfolioPath",
      "type": "promptString",
      "description": "Absolute path to the portfolio CSV"
    },
    {
      "id": "aiResponsePath",
      "type": "promptString",
      "description": "Absolute path to the saved ChatGPT response JSON"
    },
    {
      "id": "aiControlled",
      "type": "pickString",
      "description": "Were all required Temporary Chat conditions verified?",
      "options": ["0", "1"],
      "default": "0"
    }
  ]
}
