{
  "version": "2.0.0",
  "tasks": [
    {"label": "First Run: Create Configuration", "type": "process", "command": "make", "args": ["setup-config"], "problemMatcher": []},
    {"label": "First Run: Import Rakuten Portfolio", "type": "process", "command": "make", "args": ["portfolio-import", "BROKER=rakuten", "PORTFOLIO=${input:portfolioPath}"], "problemMatcher": []},
    {"label": "First Run: Check Readiness", "type": "process", "command": "make", "args": ["daily-status"], "problemMatcher": []},
    {"label": "Market Matrix: Refresh All Indices (Network)", "type": "process", "command": "make", "args": ["market-matrix"], "problemMatcher": []},
    {"label": "Daily: Add Watchlist Instrument", "type": "process", "command": "make", "args": ["watchlist-add", "INSTRUMENT=${input:instrument}"], "problemMatcher": []},
    {"label": "Daily: Remove Watchlist Instrument", "type": "process", "command": "make", "args": ["watchlist-remove", "INSTRUMENT=${input:instrument}"], "problemMatcher": []},
    {"label": "Daily: Show Watchlist", "type": "process", "command": "make", "args": ["watchlist-show"], "problemMatcher": []},
    {"label": "Daily: Analyze JP Watchlist (Network)", "type": "process", "command": "make", "args": ["daily-jp"], "problemMatcher": []},
    {"label": "Daily: Analyze US Watchlist (Network)", "type": "process", "command": "make", "args": ["daily-us"], "problemMatcher": []},
    {"label": "Daily: Build Weekly Brief", "type": "process", "command": "make", "args": ["weekly"], "problemMatcher": []},
    {"label": "Daily: Show Portfolio", "type": "process", "command": "make", "args": ["portfolio-show"], "problemMatcher": []},
    {"label": "Analysis: Build Workspace", "type": "process", "command": "make", "args": ["analysis-build"], "problemMatcher": []},
    {"label": "Analysis: Show Workspace", "type": "process", "command": "make", "args": ["analysis-show"], "problemMatcher": []},
    {"label": "Analysis: Build and Verify Workspace", "type": "process", "command": "make", "args": ["analysis-demo"], "problemMatcher": []},
    {"label": "Developer: Sync", "type": "process", "command": "make", "args": ["sync"], "problemMatcher": []},
    {"label": "Developer: Format", "type": "process", "command": "make", "args": ["format"], "problemMatcher": []},
    {"label": "Developer: Format Check", "type": "process", "command": "make", "args": ["format-check"], "problemMatcher": []},
    {"label": "Developer: Lint", "type": "process", "command": "make", "args": ["lint"], "problemMatcher": []},
    {"label": "Developer: Type Check", "type": "process", "command": "make", "args": ["typecheck"], "problemMatcher": []},
    {"label": "Developer: Test Current File", "type": "process", "command": "make", "args": ["test", "TEST=${relativeFile}"], "problemMatcher": []},
    {"label": "Developer: Check", "type": "process", "command": "make", "args": ["check"], "group": "test", "problemMatcher": []},
    {"label": "Developer: Review Evidence", "type": "process", "command": "make", "args": ["evidence"], "group": "test", "problemMatcher": []},
    {"label": "Developer: Build Distributions", "type": "process", "command": "make", "args": ["build"], "problemMatcher": []}
  ],
  "inputs": [
    {"id": "portfolioPath", "type": "promptString", "description": "Absolute path to the Rakuten assetbalance(all) CSV"},
    {"id": "instrument", "type": "promptString", "description": "Instrument in MIC:SYMBOL form", "default": "XTKS:7203"}
  ]
}
