{
  "version": "2.0.0",
  "tasks": [
    {"label": "Setup: Create Configuration", "type": "process", "command": "make", "args": ["setup-config"], "problemMatcher": []},
    {"label": "Setup: Import Rakuten Portfolio", "type": "process", "command": "make", "args": ["portfolio-import", "BROKER=rakuten", "PORTFOLIO=${input:portfolioPath}"], "problemMatcher": []},
    {"label": "Setup: Check Readiness", "type": "process", "command": "make", "args": ["daily-status"], "problemMatcher": []},
    {"label": "Setup: Doctor", "type": "process", "command": "make", "args": ["doctor"], "problemMatcher": []},
    {"label": "Market: Refresh Snapshot (Network)", "type": "process", "command": "make", "args": ["market-snapshot"], "problemMatcher": []},
    {"label": "Market: Resume Snapshot (Network)", "type": "process", "command": "make", "args": ["market-resume", "RUN_ID=${input:runId}"], "problemMatcher": []},
    {"label": "Market: List Snapshots", "type": "process", "command": "make", "args": ["market-list"], "problemMatcher": []},
    {"label": "Market: Show Snapshot", "type": "process", "command": "make", "args": ["market-show", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Market: Query JP", "type": "process", "command": "make", "args": ["market-query", "MARKET=jp", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Market: Query US", "type": "process", "command": "make", "args": ["market-query", "MARKET=us", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Market: Show Security", "type": "process", "command": "make", "args": ["market-security", "INSTRUMENT=${input:instrument}", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Market: Compare Securities", "type": "process", "command": "make", "args": ["market-compare", "INSTRUMENTS=${input:instruments}", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Research: Build Security Pack (Network)", "type": "process", "command": "make", "args": ["security-research", "INSTRUMENT=${input:instrument}", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Research: List Security Packs", "type": "process", "command": "make", "args": ["research-list"], "problemMatcher": []},
    {"label": "Research: Show Security Pack", "type": "process", "command": "make", "args": ["research-show", "RESEARCH_ID=${input:researchId}", "INSTRUMENT=${input:instrument}", "SNAPSHOT=${input:snapshotId}"], "problemMatcher": []},
    {"label": "Portfolio: Show", "type": "process", "command": "make", "args": ["portfolio-show"], "problemMatcher": []},
    {"label": "Watchlist: Add", "type": "process", "command": "make", "args": ["watchlist-add", "INSTRUMENT=${input:instrument}"], "problemMatcher": []},
    {"label": "Watchlist: Remove", "type": "process", "command": "make", "args": ["watchlist-remove", "INSTRUMENT=${input:instrument}"], "problemMatcher": []},
    {"label": "Watchlist: Show", "type": "process", "command": "make", "args": ["watchlist-show"], "problemMatcher": []},
    {"label": "Routine: Analyze JP (Network)", "type": "process", "command": "make", "args": ["daily-jp"], "problemMatcher": []},
    {"label": "Routine: Analyze US (Network)", "type": "process", "command": "make", "args": ["daily-us"], "problemMatcher": []},
    {"label": "Routine: Build Weekly Brief", "type": "process", "command": "make", "args": ["weekly"], "problemMatcher": []},
    {"label": "Developer: Sync", "type": "process", "command": "make", "args": ["sync"], "problemMatcher": []},
    {"label": "Developer: Format", "type": "process", "command": "make", "args": ["format"], "problemMatcher": []},
    {"label": "Developer: Format Check", "type": "process", "command": "make", "args": ["format-check"], "problemMatcher": []},
    {"label": "Developer: Lint", "type": "process", "command": "make", "args": ["lint"], "problemMatcher": []},
    {"label": "Developer: Type Check", "type": "process", "command": "make", "args": ["typecheck"], "problemMatcher": []},
    {"label": "Developer: Test Current File", "type": "process", "command": "make", "args": ["test", "TEST=${relativeFile}"], "problemMatcher": []},
    {"label": "Developer: Test All", "type": "process", "command": "make", "args": ["test"], "problemMatcher": []},
    {"label": "Developer: Check", "type": "process", "command": "make", "args": ["check"], "group": "test", "problemMatcher": []},
    {"label": "Developer: Build Distributions", "type": "process", "command": "make", "args": ["build"], "problemMatcher": []},
    {"label": "Developer: Review Evidence", "type": "process", "command": "make", "args": ["evidence"], "group": "test", "problemMatcher": []}
  ],
  "inputs": [
    {"id": "portfolioPath", "type": "promptString", "description": "Absolute path to the Rakuten assetbalance(all) CSV"},
    {"id": "instrument", "type": "promptString", "description": "Instrument in MIC:SYMBOL form", "default": "XTKS:7203"},
    {"id": "instruments", "type": "promptString", "description": "Space-separated instruments", "default": "XTKS:7203 XNAS:MSFT"},
    {"id": "snapshotId", "type": "promptString", "description": "Market Snapshot ID or latest", "default": "latest"},
    {"id": "researchId", "type": "promptString", "description": "Research ID or latest", "default": "latest"},
    {"id": "runId", "type": "promptString", "description": "Interrupted Market Snapshot run ID"}
  ]
}
