{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-diff:1.0.0",
  "type": "object",
  "required": ["schema", "left_snapshot_id", "right_snapshot_id", "added_instruments", "removed_instruments", "comparable_fields", "incompatible_fields", "changed_securities"],
  "properties": {
    "schema": {"const": "market-snapshot-diff/v1"},
    "left_snapshot_id": {"$ref": "#/$defs/id"}, "right_snapshot_id": {"$ref": "#/$defs/id"},
    "added_instruments": {"$ref": "#/$defs/strings"}, "removed_instruments": {"$ref": "#/$defs/strings"}, "comparable_fields": {"$ref": "#/$defs/strings"},
    "incompatible_fields": {"$ref": "#/$defs/strings"},
    "changed_securities": {"type": "array", "items": {"type": "object", "required": ["instrument_id", "fields"], "properties": {"instrument_id": {"type": "string"}, "fields": {"type": "object", "minProperties": 1}}, "additionalProperties": false}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
  "additionalProperties": false
}
