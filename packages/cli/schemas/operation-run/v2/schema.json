{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:operation-run:2.0.0",
  "$defs": {
    "progress": {
      "type": "object",
      "required": ["phase", "state", "completed", "total", "failure_count"],
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "state": {"enum": ["started", "running", "retrying", "completed"]},
        "completed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "failure_count": {"type": "integer", "minimum": 0},
        "attempt": {"type": "integer", "minimum": 2},
        "max_attempts": {"type": "integer", "minimum": 2},
        "retry_after_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "run_id", "command", "input_fingerprint", "started_at", "updated_at", "ended_at", "status", "exit_code", "attempt", "resumable", "published_object_ids", "current_progress", "acquired_count", "coverage", "duration_seconds"],
  "properties": {
    "schema": {"const": "operation-run/v2"},
    "run_id": {"type": "string", "format": "uuid"},
    "command": {"type": "string", "minLength": 1},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["running", "completed", "failed", "cancelled"]},
    "exit_code": {"type": ["integer", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "resumable": {"type": "boolean"},
    "resume_run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "resume_command": {"type": "string", "minLength": 1},
    "published_object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "current_progress": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/progress"}]},
    "acquired_count": {"type": ["integer", "null"], "minimum": 0},
    "coverage": {"type": ["object", "null"]},
    "duration_seconds": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
