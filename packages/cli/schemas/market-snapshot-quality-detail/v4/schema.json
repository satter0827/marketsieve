    "not_applicable": {"type": "integer", "minimum": 0},
    "coverage": {"type": ["string", "null"]},
    "fields": {"type": "object"},
    "instrument_id": {"type": "string"},
    "field": {"type": "string"},
    "code": {"type": "string"}
