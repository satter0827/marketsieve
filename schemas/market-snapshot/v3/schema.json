{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot:3.0.0",
  "type": "object",
  "required": ["schema", "snapshot_id", "created_at", "inputs", "runtime_settings", "source", "row_count", "field_count", "failure_count", "coverage", "price_requirements_met", "market", "artifacts"],
  "properties": {
    "schema": {"const": "market-snapshot/v3"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "runtime_settings": {"type": "object"},
    "source": {"$ref": "#/$defs/source"},
    "row_count": {"type": "integer", "minimum": 1},
    "field_count": {"type": "integer", "minimum": 1},
    "failure_count": {"type": "integer", "minimum": 0},
    "coverage": {"type": "object", "required": ["overall", "indices"]},
    "price_requirements_met": {"type": "boolean"},
    "market": {"type": "object", "required": ["schema", "generated_at", "coverage", "price_requirements_met", "markets"]},
    "artifacts": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "object", "required": ["indices", "evidence", "history_days"], "properties": {"indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "history_days": {"type": ["integer", "null"]}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["name", "version", "dataset", "response_hash"], "properties": {"name": {"const": "yfinance"}, "version": {"type": "string"}, "dataset": {"type": "string"}, "response_hash": {"$ref": "#/$defs/id"}}, "additionalProperties": false}
  },
  "additionalProperties": true
}
