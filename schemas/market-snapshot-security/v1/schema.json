{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-security:1.0.0",
  "title": "MarketSieve authoritative Market Snapshot security row",
  "type": "object",
  "required": ["schema", "instrument_id", "instrument", "provider_symbol", "memberships", "retrieved_at", "evidence_id", "values", "missing"],
  "properties": {
    "schema": {"const": "market-snapshot-security/v1"},
    "instrument_id": {"$ref": "#/$defs/instrumentId"},
    "instrument": {"$ref": "#/$defs/instrument"},
    "provider_symbol": {"type": "string", "minLength": 1},
    "memberships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/indexName"}
    },
    "retrieved_at": {"type": "string", "format": "date-time"},
    "evidence_id": {"$ref": "#/$defs/digest"},
    "values": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "missing": {"$ref": "#/$defs/missingMap"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrumentId": {"type": "string", "pattern": "^[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]*$"},
    "indexName": {"enum": ["dow30", "nasdaq100", "nikkei225", "sp500", "topix500"]},
    "instrument": {
      "type": "object",
      "required": ["mic", "symbol", "currency", "exchange_timezone", "instrument_type"],
      "properties": {
        "mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
        "symbol": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "exchange_timezone": {"enum": ["America/New_York", "Asia/Tokyo"]},
        "instrument_type": {"const": "equity"}
      },
      "additionalProperties": false
    },
    "missingReason": {
      "enum": [
        "benchmark_unavailable",
        "corporate_action_mismatch",
        "currency_mismatch",
        "field_absent",
        "financials_unavailable",
        "history_empty",
        "insufficient_history",
        "network_error",
        "not_applicable",
        "provider_error",
        "rate_limited",
        "stale_history",
        "symbol_not_found",
        "zero_denominator"
      ]
    },
    "missingMap": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/missingReason"}
    }
  },
  "anyOf": [
    {"properties": {"values": {"minProperties": 1}}},
    {"properties": {"missing": {"minProperties": 1}}}
  ],
  "additionalProperties": false
}
