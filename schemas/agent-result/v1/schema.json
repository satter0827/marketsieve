{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:agent-result:1.0.0",
  "title": "MarketSieve explanation agent result",
  "type": "object",
  "required": ["schema_version", "operation", "status", "provider", "model"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operation": {"enum": ["doctor", "dry_run", "explain"]},
    "status": {"enum": ["ready", "not_ready", "model", "template"]},
    "provider": {"enum": ["fake", "lmstudio", "openai", "anthropic", "google"]},
    "model": {"type": ["string", "null"]},
    "endpoint": {"type": ["string", "null"]},
    "message": {"type": "string"},
    "instrument": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
    "source_profile": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "catalog_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact_count": {"type": "integer", "minimum": 0},
    "payload": {"type": "string", "minLength": 1},
    "selected_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fallback_reason": {"type": ["string", "null"]},
    "text": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "doctor"}}},
      "then": {"required": ["endpoint", "message"]}
    },
    {
      "if": {"properties": {"operation": {"const": "dry_run"}}},
      "then": {"required": ["endpoint", "prompt_version", "catalog_hash", "fact_count", "payload"]}
    },
    {
      "if": {"properties": {"operation": {"const": "explain"}}},
      "then": {"required": ["instrument", "source_profile", "prompt_version", "catalog_hash", "selected_fact_ids", "fallback_reason", "text"]}
    }
  ],
  "additionalProperties": false
}
