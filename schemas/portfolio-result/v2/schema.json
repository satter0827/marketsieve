{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:portfolio-result:2.0.0",
  "title": "MarketSieve Portfolio Result",
  "type": "object",
  "required": ["object_id", "schema", "as_of", "source", "source_name", "source_version", "dataset", "source_hash", "diagnostics", "holdings", "watch_items"],
  "properties": {
    "object_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema": {"const": "portfolio-result/v2"},
    "as_of": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostics": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "holdings": {
      "type": "array",
      "items": {"$ref": "#/$defs/holding"}
    },
    "watch_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/watch_item"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "instrument": {
      "type": "object",
      "required": ["mic", "symbol", "currency", "timezone", "type"],
      "properties": {
        "mic": {"type": "string"},
        "symbol": {"type": "string"},
        "currency": {"type": "string"},
        "timezone": {"type": "string"},
        "type": {"const": "equity"}
      },
      "additionalProperties": false
    },
    "holding": {
      "type": "object",
      "required": ["instrument", "quantity", "average_acquisition_price", "account_type"],
      "properties": {
        "instrument": {"$ref": "#/$defs/instrument"},
        "quantity": {"type": "string"},
        "average_acquisition_price": {"type": "string"},
        "account_type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "watch_item": {
      "type": "object",
      "required": ["instrument"],
      "properties": {"instrument": {"$ref": "#/$defs/instrument"}},
      "additionalProperties": false
    }
  }
}
