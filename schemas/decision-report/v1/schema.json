{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:decision-report:1.0.0",
  "title": "MarketSieve decision report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema",
    "session",
    "as_of",
    "portfolio",
    "policy",
    "decisions",
    "diagnostics",
    "previous_report_id",
    "input_report_ids"
  ],
  "properties": {
    "report_id": { "$ref": "#/$defs/digest" },
    "schema": { "const": "decision-report/v1" },
    "session": { "enum": ["jp_close", "us_close", "weekly"] },
    "as_of": { "type": "string", "format": "date-time" },
    "portfolio": { "$ref": "#/$defs/portfolio" },
    "policy": { "$ref": "#/$defs/policy" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "previous_report_id": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "input_report_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/digest" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "session": { "const": "weekly" } } },
      "then": { "properties": { "input_report_ids": { "minItems": 2, "maxItems": 2 } } },
      "else": { "properties": { "input_report_ids": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "mic", "currency", "timezone", "type"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "mic": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "timezone": { "type": "string", "minLength": 1 },
        "type": { "const": "equity" }
      }
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "quantity", "average_acquisition_price", "account_type"],
      "properties": {
        "instrument": { "$ref": "#/$defs/instrument" },
        "quantity": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
        "average_acquisition_price": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "account_type": { "type": "string", "minLength": 1 }
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "source", "holdings", "watch_items"],
      "properties": {
        "as_of": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 },
        "holdings": { "type": "array", "items": { "$ref": "#/$defs/holding" } },
        "watch_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument"],
            "properties": { "instrument": { "$ref": "#/$defs/instrument" } }
          }
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "settings"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "settings": { "$ref": "#/$defs/stringMap" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "direction", "value", "threshold", "evidence_ids"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "direction": { "enum": ["supporting", "opposing", "limitation"] },
        "value": { "type": ["string", "null"] },
        "threshold": { "type": ["string", "null"] },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "held",
        "action",
        "confidence",
        "evidence",
        "next_earnings_date",
        "revenue_growth",
        "eps_growth",
        "free_cash_flow",
        "valuation",
        "fundamentals",
        "invalidation_conditions",
        "next_action",
        "policy"
      ],
      "properties": {
        "instrument": { "$ref": "#/$defs/instrument" },
        "held": { "type": "boolean" },
        "action": {
          "enum": [
            "buy_candidate",
            "wait_for_pullback",
            "wait_for_earnings",
            "pass",
            "keep",
            "watch",
            "reduce_review",
            "sell_review",
            "indeterminate"
          ]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "next_earnings_date": { "type": ["string", "null"], "format": "date" },
        "revenue_growth": { "type": ["string", "null"] },
        "eps_growth": { "type": ["string", "null"] },
        "free_cash_flow": { "type": ["string", "null"] },
        "valuation": { "$ref": "#/$defs/stringMap" },
        "fundamentals": { "$ref": "#/$defs/stringMap" },
        "invalidation_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "next_action": { "type": "string", "minLength": 1 },
        "policy": { "$ref": "#/$defs/policy" }
      }
    }
  }
}
