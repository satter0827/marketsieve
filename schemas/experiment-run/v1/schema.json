{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:experiment-run:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "spec_id", "profit_simulation", "spec", "decisions", "metrics"],
  "properties": {
    "schema": { "const": "experiment-run/v1" },
    "run_id": { "$ref": "#/$defs/digest" },
    "spec_id": { "$ref": "#/$defs/digest" },
    "profit_simulation": { "type": "boolean" },
    "spec": { "$ref": "#/$defs/spec" },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decimal": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "window", "datasets", "execution_costs"],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "settings"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "settings": { "$ref": "#/$defs/stringMap" }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        },
        "datasets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/digest" }
        },
        "execution_costs": {
          "type": "object",
          "additionalProperties": false,
          "dependentRequired": {
            "commission_rate": ["fx_cost_rate", "tax_rate"],
            "fx_cost_rate": ["commission_rate", "tax_rate"],
            "tax_rate": ["commission_rate", "fx_cost_rate"]
          },
          "properties": {
            "commission_rate": { "$ref": "#/$defs/decimal" },
            "fx_cost_rate": { "$ref": "#/$defs/decimal" },
            "tax_rate": { "$ref": "#/$defs/decimal" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "as_of", "action", "confidence"],
      "properties": {
        "instrument": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
        "as_of": { "type": "string", "format": "date-time" },
        "action": {
          "enum": ["buy_candidate", "wait_for_pullback", "wait_for_earnings", "pass", "keep", "watch", "reduce_review", "sell_review", "indeterminate"]
        },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "$ref": "#/$defs/decimal" },
        "unit": { "enum": ["observations", "ratio", "count"] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average_holding_period", "data_coverage", "decision_change_count", "decision_count", "forward_return", "maximum_drawdown"],
      "properties": {
        "average_holding_period": { "$ref": "#/$defs/metric" },
        "data_coverage": { "$ref": "#/$defs/metric" },
        "decision_change_count": { "$ref": "#/$defs/metric" },
        "decision_count": { "$ref": "#/$defs/metric" },
        "forward_return": { "$ref": "#/$defs/metric" },
        "maximum_drawdown": { "$ref": "#/$defs/metric" }
      }
    }
  }
}
