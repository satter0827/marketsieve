{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:analysis-context:2.0.0",
  "title": "MarketSieve matrix analysis context",
  "type": "object",
  "required": ["context_id", "schema", "as_of", "matrix", "constraints"],
  "properties": {
    "context_id": {"$ref": "#/$defs/digest"},
    "schema": {"const": "analysis-context/v2"},
    "as_of": {"type": "string", "format": "date-time"},
    "matrix": {
      "type": "object",
      "required": [
        "matrix_id", "created_at", "row_count", "field_count", "quality_status",
        "coverage", "manifest_path", "fields_path", "index_summary_path",
        "securities_jsonl_path", "failures_jsonl_path"
      ],
      "properties": {
        "matrix_id": {"$ref": "#/$defs/digest"},
        "created_at": {"type": "string", "format": "date-time"},
        "row_count": {"type": "integer", "minimum": 0},
        "field_count": {"type": "integer", "minimum": 1},
        "quality_status": {"enum": ["ready", "partial"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "manifest_path": {"type": "string", "minLength": 1},
        "fields_path": {"type": "string", "minLength": 1},
        "index_summary_path": {"type": "string", "minLength": 1},
        "securities_jsonl_path": {"type": "string", "minLength": 1},
        "failures_jsonl_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {
      "type": "object", "required": ["overall", "indices"],
      "properties": {
        "overall": {"type": "string"},
        "indices": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
