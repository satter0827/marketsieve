{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-matrix:2.0.0",
  "title": "MarketSieve market matrix projection",
  "type": "object",
  "required": ["schema", "matrix_id", "created_at", "request", "source", "input_snapshot_id", "universe_assets", "configuration", "row_count", "field_count", "failure_count", "coverage", "quality_status", "summary", "artifacts"],
  "properties": {
    "schema": {"const": "market-matrix/v2"},
    "matrix_id": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "request": {"$ref": "#/$defs/request"},
    "source": {"$ref": "#/$defs/source"},
    "input_snapshot_id": {"$ref": "#/$defs/digest"},
    "universe_assets": {"type": "object"},
    "configuration": {"type": "object"},
    "row_count": {"type": "integer", "minimum": 1},
    "field_count": {"type": "integer", "minimum": 1},
    "failure_count": {"type": "integer", "minimum": 0},
    "coverage": {"$ref": "#/$defs/coverage"},
    "quality_status": {"enum": ["ready", "partial"]},
    "summary": {"$ref": "#/$defs/summary"},
    "artifacts": {"$ref": "#/$defs/artifacts"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "indexName": {"enum": ["dow30", "nasdaq100", "nikkei225", "sp500", "topix500"]},
    "request": {
      "type": "object",
      "required": ["fingerprint", "schema", "indices", "assets", "start", "end", "adjustment", "settings", "source"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/digest"},
        "schema": {"const": "market-matrix-request/v1"},
        "indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/indexName"}},
        "assets": {"type": "object"},
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "adjustment": {"const": "adjusted"},
        "settings": {"type": "object"},
        "source": {
          "type": "object",
          "required": ["name", "profile"],
          "properties": {
            "name": {"const": "yfinance"},
            "profile": {"const": "matrix-yfinance"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "version", "dataset", "response_hash"],
      "properties": {
        "name": {"const": "yfinance"},
        "version": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "response_hash": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["overall", "indices"],
      "properties": {
        "overall": {"type": "string", "minLength": 1},
        "indices": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/indexName"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["count", "p25", "median", "p75"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "p25": {"type": "string", "minLength": 1},
        "median": {"type": "string", "minLength": 1},
        "p75": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "distributionsByCurrency": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z]{3}$"},
      "additionalProperties": {"$ref": "#/$defs/distribution"}
    },
    "currencyDistributions": {
      "type": "object",
      "required": ["market_cap", "median_traded_value_20d"],
      "properties": {
        "market_cap": {"$ref": "#/$defs/distributionsByCurrency"},
        "median_traded_value_20d": {"$ref": "#/$defs/distributionsByCurrency"}
      },
      "additionalProperties": false
    },
    "concentrationEntry": {
      "type": "object",
      "required": ["market_cap_observation_count", "top_10_market_cap_share"],
      "properties": {
        "market_cap_observation_count": {"type": "integer", "minimum": 0},
        "top_10_market_cap_share": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "concentration": {
      "type": "object",
      "required": ["market_cap_observation_count", "top_10_market_cap_share", "by_currency"],
      "properties": {
        "market_cap_observation_count": {"type": "integer", "minimum": 0},
        "top_10_market_cap_share": {"type": ["string", "null"]},
        "by_currency": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z]{3}$"},
          "additionalProperties": {"$ref": "#/$defs/concentrationEntry"}
        }
      },
      "additionalProperties": false
    },
    "sector": {
      "type": "object",
      "required": ["security_count", "market_cap_share", "market_cap_share_by_currency"],
      "properties": {
        "security_count": {"type": "integer", "minimum": 1},
        "market_cap_share": {"type": ["string", "null"]},
        "market_cap_share_by_currency": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z]{3}$"},
          "additionalProperties": {"type": ["string", "null"]}
        }
      },
      "additionalProperties": false
    },
    "missing": {
      "type": "object",
      "required": ["fields", "reasons"],
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "reasons": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["security_count", "price_count", "price_coverage", "advancing_count", "declining_count", "unchanged_count", "above_sma_20_count", "above_sma_200_count", "distributions", "currency_distributions", "concentration", "sectors", "missing"],
      "properties": {
        "security_count": {"type": "integer", "minimum": 1},
        "price_count": {"type": "integer", "minimum": 0},
        "price_coverage": {"type": "string", "minLength": 1},
        "advancing_count": {"type": "integer", "minimum": 0},
        "declining_count": {"type": "integer", "minimum": 0},
        "unchanged_count": {"type": "integer", "minimum": 0},
        "above_sma_20_count": {"type": "integer", "minimum": 0},
        "above_sma_200_count": {"type": "integer", "minimum": 0},
        "distributions": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/distribution"}
        },
        "currency_distributions": {"$ref": "#/$defs/currencyDistributions"},
        "concentration": {"$ref": "#/$defs/concentration"},
        "sectors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sector"}},
        "missing": {"$ref": "#/$defs/missing"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["schema", "generated_at", "coverage", "quality_status", "groups"],
      "properties": {
        "schema": {"const": "market-matrix-summary/v1"},
        "generated_at": {"type": "string", "format": "date-time"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "quality_status": {"enum": ["ready", "partial"]},
        "groups": {
          "type": "object",
          "required": ["all"],
          "minProperties": 2,
          "propertyNames": {"enum": ["all", "dow30", "nasdaq100", "nikkei225", "sp500", "topix500"]},
          "additionalProperties": {"$ref": "#/$defs/group"}
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["README.md", "manifest.json", "fields.json", "missing-reasons.json", "securities.jsonl", "index-summary.json", "failures.jsonl", "matrix.csv", "overview.html", "summary.md"],
      "properties": {
        "README.md": {"type": "string", "minLength": 1},
        "manifest.json": {"type": "string", "minLength": 1},
        "fields.json": {"type": "string", "minLength": 1},
        "missing-reasons.json": {"type": "string", "minLength": 1},
        "securities.jsonl": {"type": "string", "minLength": 1},
        "index-summary.json": {"type": "string", "minLength": 1},
        "failures.jsonl": {"type": "string", "minLength": 1},
        "matrix.csv": {"type": "string", "minLength": 1},
        "overview.html": {"type": "string", "minLength": 1},
        "summary.md": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
