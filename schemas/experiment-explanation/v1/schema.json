{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:experiment-explanation:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "explanation_id", "status", "provider", "model", "model_settings", "prompt_version", "run_id", "catalog_hash", "selected_fact_ids", "prompt", "model_output", "validation", "text"],
  "properties": {
    "schema": { "const": "experiment-explanation/v1" },
    "explanation_id": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["model", "template"] },
    "provider": { "enum": ["lmstudio", "openai", "anthropic", "google"] },
    "model": { "type": "string", "minLength": 1 },
    "model_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "endpoint", "locale"],
      "properties": {
        "provider": { "enum": ["lmstudio", "openai", "anthropic", "google"] },
        "model": { "type": "string", "minLength": 1 },
        "endpoint": { "type": ["string", "null"] },
        "locale": { "enum": ["ja", "en"] }
      }
    },
    "prompt_version": { "const": "experiment-fact-selection-v1" },
    "run_id": { "$ref": "#/$defs/digest" },
    "catalog_hash": { "$ref": "#/$defs/digest" },
    "selected_fact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "payload"],
      "properties": {
        "version": { "const": "experiment-fact-selection-v1" },
        "payload": { "type": "string", "minLength": 1 }
      }
    },
    "model_output": { "type": ["string", "null"] },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "text": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "model" } } },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "status": { "const": "accepted" },
              "reason": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "template" } } },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "status": { "const": "rejected" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
