{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:demo-result:1.0.0",
  "title": "MarketSieve offline demo result",
  "type": "object",
  "required": ["schema_version", "results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "result": {
      "type": "object",
      "required": [
        "market",
        "instrument",
        "input",
        "observations",
        "analysis",
        "provenance",
        "evidence_id"
      ],
      "properties": {
        "market": {"enum": ["jp", "us"]},
        "instrument": {
          "type": "object",
          "required": [
            "symbol",
            "mic",
            "currency",
            "exchange_timezone",
            "instrument_type"
          ],
          "properties": {
            "symbol": {"type": "string"},
            "mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "exchange_timezone": {"type": "string"},
            "instrument_type": {"const": "equity"}
          },
          "additionalProperties": false
        },
        "input": {
          "type": "object",
          "required": ["start", "end", "as_of", "adjustment"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"},
            "as_of": {"type": "string", "format": "date-time"},
            "adjustment": {"enum": ["raw", "adjusted"]}
          },
          "additionalProperties": false
        },
        "observations": {
          "type": "object",
          "required": ["included", "excluded_after_as_of"],
          "properties": {
            "included": {"type": "integer", "minimum": 0},
            "excluded_after_as_of": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "required": [
            "indicator",
            "period",
            "definition",
            "status",
            "current_date",
            "current_close",
            "current_sma",
            "current_state",
            "previous_state",
            "transition"
          ],
          "properties": {
            "indicator": {"const": "SMA20"},
            "period": {"const": 20},
            "definition": {"const": "arithmetic_mean_of_latest_20_closes"},
            "status": {"enum": ["ok", "insufficient_history"]},
            "current_date": {"type": ["string", "null"], "format": "date"},
            "current_close": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
            "current_sma": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
            "current_state": {"enum": ["above", "below", "equal", null]},
            "previous_state": {"enum": ["above", "below", "equal", null]},
            "transition": {
              "type": ["string", "null"],
              "pattern": "^(above|below|equal)_to_(above|below|equal)$"
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "dataset", "version"],
            "properties": {
              "source": {"type": "string"},
              "dataset": {"type": "string"},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            },
            "additionalProperties": false
          }
        },
        "evidence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
