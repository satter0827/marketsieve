{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:security-research-list:1.0.0",
  "title": "MarketSieve Security Research history",
  "type": "object",
  "required": ["schema", "research"],
  "properties": {
    "schema": {"const": "security-research-list/v1"},
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["research_id", "snapshot_id", "instrument_id", "created_at", "price_requirements_met"],
        "properties": {
          "research_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "instrument_id": {"type": "string", "pattern": "^[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]*$"},
          "created_at": {"type": "string", "format": "date-time"},
          "price_requirements_met": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
