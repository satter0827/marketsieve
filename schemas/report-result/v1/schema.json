{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:report-result:1.0.0",
  "title": "MarketSieve historical report result",
  "type": "object",
  "required": ["schema_version", "reports"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/report"}
    }
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrument": {
      "type": "object",
      "required": ["symbol", "mic", "currency", "exchange_timezone", "instrument_type"],
      "properties": {
        "symbol": {"type": "string"},
        "mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "exchange_timezone": {"type": "string"},
        "instrument_type": {"const": "equity"}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": ["indicator", "period", "definition", "status", "current_date", "current_close", "current_sma", "current_state", "evidence_id"],
      "properties": {
        "indicator": {"const": "SMA20"},
        "period": {"const": 20},
        "definition": {"const": "arithmetic_mean_of_latest_20_closes"},
        "status": {"enum": ["ok", "insufficient_history"]},
        "current_date": {"type": ["string", "null"], "format": "date"},
        "current_close": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "current_sma": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "current_state": {"enum": ["above", "below", "equal", null]},
        "evidence_id": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["market", "instrument", "input", "latest", "transitions", "provenance", "replay_id", "report_id"],
      "properties": {
        "market": {"enum": ["jp", "us"]},
        "instrument": {"$ref": "#/$defs/instrument"},
        "input": {
          "type": "object",
          "required": ["start", "end", "adjustment", "first_as_of", "last_as_of", "evaluation_count"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"},
            "adjustment": {"enum": ["raw", "adjusted"]},
            "first_as_of": {"type": "string", "format": "date-time"},
            "last_as_of": {"type": "string", "format": "date-time"},
            "evaluation_count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "latest": {"$ref": "#/$defs/analysis"},
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["as_of", "trading_date", "previous_state", "current_state", "evidence_id"],
            "properties": {
              "as_of": {"type": "string", "format": "date-time"},
              "trading_date": {"type": "string", "format": "date"},
              "previous_state": {"enum": ["above", "below", "equal"]},
              "current_state": {"enum": ["above", "below", "equal"]},
              "evidence_id": {"$ref": "#/$defs/digest"}
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "dataset", "version"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "dataset": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "replay_id": {"$ref": "#/$defs/digest"},
        "report_id": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
