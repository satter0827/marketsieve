{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:report-result:2.0.0",
  "title": "MarketSieve equity report projection",
  "type": "object",
  "required": ["schema_version", "instrument", "source_profile", "as_of", "sections", "summary", "disclaimer", "report_id"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "instrument": {"type": "object"},
    "source_profile": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "sections": {"type": "object"},
    "summary": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["section", "status", "completeness", "evidence_id"],
        "properties": {
          "section": {"type": "string"},
          "status": {"enum": ["available", "partial", "unavailable", "invalid"]},
          "completeness": {"type": "string"},
          "evidence_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "disclaimer": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
