{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:report-ai-explanation:1.0.0",
  "title": "MarketSieve validated manual AI explanation",
  "type": "object",
  "required": ["explanation_id", "schema", "request_id", "response_id", "validation_id", "report_id", "trial", "service", "model_label", "controlled", "prompt_version", "catalog_hash", "selected_fact_ids", "text"],
  "properties": {
    "explanation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema": {"const": "report-ai-explanation/v1"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial": {"type": "integer", "minimum": 1},
    "service": {"const": "chatgpt"},
    "model_label": {"type": ["string", "null"]},
    "controlled": {"type": "boolean"},
    "prompt_version": {"type": "string", "minLength": 1},
    "catalog_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_fact_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "text": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
