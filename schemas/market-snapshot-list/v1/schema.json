{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-list:1.0.0",
  "title": "MarketSieve persisted Market Snapshot list",
  "type": "object",
  "required": ["schema", "snapshots"],
  "properties": {
    "schema": {"const": "market-snapshot-list/v1"},
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["snapshot_id", "created_at", "row_count", "field_count", "coverage", "price_requirements_met"],
        "properties": {
          "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "created_at": {"type": "string", "format": "date-time"},
          "row_count": {"type": "integer", "minimum": 1},
          "field_count": {"type": "integer", "minimum": 1},
          "coverage": {"$ref": "#/$defs/coverage"},
          "price_requirements_met": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "required": ["overall", "indices"],
      "properties": {
        "overall": {"type": "string", "minLength": 1},
        "indices": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["dow30", "nasdaq100", "nikkei225", "sp500", "topix500"]},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
