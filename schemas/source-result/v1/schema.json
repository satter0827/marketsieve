{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:source-result:1.0.0",
  "title": "MarketSieve source result",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "distribution", "version", "entry_point", "data_kinds", "loaded"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "distribution": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "entry_point": {"type": "string", "minLength": 1},
          "data_kinds": {
            "type": "array",
            "items": {"enum": ["daily_bars", "financials", "events", "economic_series"]},
            "uniqueItems": true
          },
          "loaded": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "status": {"enum": ["imported", "fetched"]},
    "object_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_profile": {"type": "string", "minLength": 1},
    "instrument": {"type": "string", "pattern": "^[A-Z0-9]{4}:[A-Z0-9]+$"},
    "kind": {"enum": ["daily_bars", "financials", "events"]},
    "observations": {"type": "integer", "minimum": 0},
    "instrument_profile": {"type": "boolean"},
    "plugin": {"type": "string", "minLength": 1},
    "ready": {"type": "boolean"},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "recovery": {"type": ["string", "null"]}
  },
  "oneOf": [
    {"required": ["sources"]},
    {"required": ["status", "object_id", "source_profile", "instrument", "kind", "observations"]},
    {"required": ["source_profile", "plugin", "ready", "code", "message", "recovery"]}
  ],
  "additionalProperties": false
}
