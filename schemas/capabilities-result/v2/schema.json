{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:capabilities-result:2.0.0",
  "title": "MarketSieve CLI capabilities",
  "type": "object",
  "required": ["schema_version", "program", "version", "global_options", "commands", "streams", "exit_codes"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "program": {"const": "marketsieve"},
    "version": {"type": "string", "minLength": 1},
    "global_options": {"$ref": "#/$defs/options"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "summary", "options", "output_schema", "effects"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "options": {"$ref": "#/$defs/options"},
          "output_schema": {
            "type": ["string", "null"],
            "pattern": "^urn:marketsieve:schema:"
          },
          "effects": {
            "type": "object",
            "required": ["network", "secrets", "optional_writes"],
            "properties": {
              "network": {"type": "boolean"},
              "secrets": {"type": "boolean"},
              "optional_writes": {
                "type": "array",
                "items": {"enum": ["explanation", "log_file", "portfolio", "report", "snapshot"]},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "streams": {
      "type": "object",
      "required": ["success", "errors", "structured_logs"],
      "properties": {
        "success": {"const": "stdout"},
        "errors": {"const": "stderr"},
        "structured_logs": {"const": "stderr_when_requested"}
      },
      "additionalProperties": false
    },
    "exit_codes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["code", "meaning"],
        "properties": {
          "code": {"type": "integer"},
          "meaning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "flags", "required", "default", "choices"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "flags": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"},
          "default": {},
          "choices": {"type": ["array", "null"], "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
