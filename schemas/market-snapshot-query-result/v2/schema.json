{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-query-result:2.0.0",
  "type": "object",
  "required": ["schema", "snapshot_id", "filters", "fields", "matched_count", "total_matched_count", "profile", "domains", "order", "limit", "rows"],
  "properties": {
    "schema": {"const": "market-snapshot-query-result/v2"},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filters": {"type": "object"},
    "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "matched_count": {"type": "integer", "minimum": 0},
    "total_matched_count": {"type": "integer", "minimum": 0},
    "profile": {"type": ["string", "null"], "enum": ["short-swing", "swing", "position", null]},
    "domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:(?:asc|desc)$"}},
    "limit": {"type": ["integer", "null"], "minimum": 1},
    "rows": {"type": "array", "items": {"type": "object", "required": ["instrument_id", "instrument", "provider_symbol", "memberships", "retrieved_at", "values", "missing"]}}
  },
  "additionalProperties": false
}
