{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-query-result:1.0.0",
  "title": "MarketSieve persisted Market Snapshot query result",
  "type": "object",
  "required": ["schema", "snapshot_id", "filters", "fields", "matched_count", "rows"],
  "properties": {
    "schema": {"const": "market-snapshot-query-result/v1"},
    "snapshot_id": {"$ref": "#/$defs/digest"},
    "filters": {"$ref": "#/$defs/filters"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fieldName"}
    },
    "matched_count": {"type": "integer", "minimum": 0},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fieldName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "instrumentId": {"type": "string", "pattern": "^[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]*$"},
    "indexName": {"enum": ["dow30", "nasdaq100", "nikkei225", "sp500", "topix500"]},
    "missingReason": {
      "enum": ["benchmark_unavailable", "corporate_action_mismatch", "currency_mismatch", "field_absent", "financials_unavailable", "history_empty", "insufficient_history", "network_error", "not_applicable", "provider_error", "rate_limited", "stale_history", "symbol_not_found", "zero_denominator"]
    },
    "instrument": {
      "type": "object",
      "required": ["mic", "symbol", "currency", "exchange_timezone", "instrument_type"],
      "properties": {
        "mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
        "symbol": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "exchange_timezone": {"enum": ["America/New_York", "Asia/Tokyo"]},
        "instrument_type": {"const": "equity"}
      },
      "additionalProperties": false
    },
    "stringSelection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "classifications": {
      "type": "object",
      "properties": {
        "market": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["jp", "us"]}},
        "index": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/indexName"}},
        "mic": {"$ref": "#/$defs/stringSelection"},
        "exchange": {"$ref": "#/$defs/stringSelection"},
        "country": {"$ref": "#/$defs/stringSelection"},
        "currency": {"$ref": "#/$defs/stringSelection"},
        "sector": {"$ref": "#/$defs/stringSelection"},
        "industry": {"$ref": "#/$defs/stringSelection"}
      },
      "additionalProperties": false
    },
    "numericBounds": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/fieldName"},
      "additionalProperties": {"type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"}
    },
    "fieldSelection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fieldName"}
    },
    "filters": {
      "type": "object",
      "required": ["classifications", "minimums", "maximums", "present", "missing"],
      "properties": {
        "classifications": {"$ref": "#/$defs/classifications"},
        "minimums": {"$ref": "#/$defs/numericBounds"},
        "maximums": {"$ref": "#/$defs/numericBounds"},
        "present": {"$ref": "#/$defs/fieldSelection"},
        "missing": {"$ref": "#/$defs/fieldSelection"}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["instrument_id", "instrument", "provider_symbol", "memberships", "retrieved_at", "values", "missing"],
      "properties": {
        "instrument_id": {"$ref": "#/$defs/instrumentId"},
        "instrument": {"$ref": "#/$defs/instrument"},
        "provider_symbol": {"type": "string", "minLength": 1},
        "memberships": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/indexName"}},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "values": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/fieldName"},
          "additionalProperties": {"type": "string"}
        },
        "missing": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/fieldName"},
          "additionalProperties": {"$ref": "#/$defs/missingReason"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
