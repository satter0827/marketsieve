{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:indicator-result:1.0.0",
  "title": "MarketSieve indicator result",
  "type": "object",
  "required": ["schema_version", "instrument", "source_profile", "snapshot_id", "indicator"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "instrument": {"type": "string", "pattern": "^[A-Z0-9]{4}:[A-Z0-9]+$"},
    "source_profile": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "indicator": {
      "type": "object",
      "required": ["name", "definition_version", "parameters", "status", "as_of", "values", "observation_count", "numeric_policy", "evidence_id"],
      "properties": {
        "name": {"enum": ["sma", "ema", "rsi", "macd", "atr", "period_return", "maximum_drawdown"]},
        "definition_version": {"type": "string", "minLength": 1},
        "parameters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "status": {"enum": ["ok", "insufficient_history"]},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "values": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}},
        "observation_count": {"type": "integer", "minimum": 0},
        "numeric_policy": {"const": "decimal34-round-half-even-canonical-v1"},
        "evidence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
