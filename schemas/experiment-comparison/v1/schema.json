{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:experiment-comparison:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "left_run_id", "right_run_id", "metric_deltas"],
  "properties": {
    "schema": { "const": "experiment-comparison/v1" },
    "left_run_id": { "$ref": "#/$defs/digest" },
    "right_run_id": { "$ref": "#/$defs/digest" },
    "metric_deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average_holding_period", "data_coverage", "decision_change_count", "decision_count", "forward_return", "maximum_drawdown"],
      "properties": {
        "average_holding_period": { "$ref": "#/$defs/metric" },
        "data_coverage": { "$ref": "#/$defs/metric" },
        "decision_change_count": { "$ref": "#/$defs/metric" },
        "decision_count": { "$ref": "#/$defs/metric" },
        "forward_return": { "$ref": "#/$defs/metric" },
        "maximum_drawdown": { "$ref": "#/$defs/metric" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "unit": { "enum": ["observations", "ratio", "count"] }
      }
    }
  }
}
