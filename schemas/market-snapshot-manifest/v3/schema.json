{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-manifest:3.0.0",
  "type": "object",
  "required": ["schema", "snapshot_id", "created_at", "request", "inputs", "runtime_settings", "runtime_settings_hash", "request_fingerprint", "source", "input_snapshot_id", "universe_assets", "row_count", "field_count", "failure_count", "coverage", "price_requirements_met", "artifacts"],
  "properties": {
    "schema": {"const": "market-snapshot-manifest/v3"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "request": {"type": "object", "required": ["fingerprint", "schema", "inputs", "runtime_settings", "runtime_settings_hash", "source"]},
    "inputs": {"type": "object", "required": ["indices", "evidence", "history_days"]},
    "runtime_settings": {"type": "object"},
    "runtime_settings_hash": {"$ref": "#/$defs/id"},
    "request_fingerprint": {"$ref": "#/$defs/id"},
    "source": {"type": "object", "required": ["name", "version", "dataset", "response_hash"]},
    "input_snapshot_id": {"$ref": "#/$defs/id"},
    "universe_assets": {"type": "object", "minProperties": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "field_count": {"type": "integer", "minimum": 1},
    "failure_count": {"type": "integer", "minimum": 0},
    "coverage": {"type": "object", "required": ["overall", "indices"]},
    "price_requirements_met": {"type": "boolean"},
    "artifacts": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "object", "required": ["path", "role"], "properties": {"path": {"type": "string"}, "role": {"type": "string"}}, "additionalProperties": false}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
