{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-snapshot-manifest:2.0.0",
  "title": "MarketSieve self-contained Market Snapshot manifest",
  "type": "object",
  "required": ["schema", "snapshot_id", "created_at", "request", "source", "input_snapshot_id", "universe_assets", "configuration", "row_count", "field_count", "failure_count", "coverage", "price_requirements_met", "artifacts"],
  "properties": {
    "schema": {"const": "market-snapshot-manifest/v2"},
    "snapshot_id": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "request": {"$ref": "#/$defs/request"},
    "source": {"$ref": "#/$defs/source"},
    "input_snapshot_id": {"$ref": "#/$defs/digest"},
    "universe_assets": {"type": "object"},
    "configuration": {"type": "object"},
    "row_count": {"type": "integer", "minimum": 1},
    "field_count": {"type": "integer", "minimum": 1},
    "failure_count": {"type": "integer", "minimum": 0},
    "coverage": {"$ref": "#/$defs/coverage"},
    "price_requirements_met": {"type": "boolean"},
    "artifacts": {"$ref": "#/$defs/artifacts"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "indexName": {"enum": ["dow30", "nasdaq100", "nikkei225", "sp500", "topix500"]},
    "request": {
      "type": "object",
      "required": ["fingerprint", "schema", "indices", "assets", "start", "end", "adjustment", "settings", "source"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/digest"},
        "schema": {"const": "market-snapshot-request/v1"},
        "indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/indexName"}},
        "assets": {"type": "object"},
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "adjustment": {"const": "adjusted"},
        "settings": {"type": "object"},
        "source": {
          "type": "object",
          "required": ["name", "profile"],
          "properties": {
            "name": {"const": "yfinance"},
            "profile": {"const": "market-yfinance"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "version", "dataset", "response_hash"],
      "properties": {
        "name": {"const": "yfinance"},
        "version": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "response_hash": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["overall", "indices"],
      "properties": {
        "overall": {"type": "string", "minLength": 1},
        "indices": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/indexName"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/]+$"},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["README.md", "manifest.json", "definitions.json", "quality.json", "market.json", "segments.jsonl", "securities.jsonl", "failures.jsonl", "securities.csv", "explorer.html", "summary.md"],
      "properties": {
        "README.md": {"$ref": "#/$defs/artifact"},
        "manifest.json": {"$ref": "#/$defs/artifact"},
        "definitions.json": {"$ref": "#/$defs/artifact"},
        "quality.json": {"$ref": "#/$defs/artifact"},
        "market.json": {"$ref": "#/$defs/artifact"},
        "segments.jsonl": {"$ref": "#/$defs/artifact"},
        "securities.jsonl": {"$ref": "#/$defs/artifact"},
        "failures.jsonl": {"$ref": "#/$defs/artifact"},
        "securities.csv": {"$ref": "#/$defs/artifact"},
        "explorer.html": {"$ref": "#/$defs/artifact"},
        "summary.md": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
