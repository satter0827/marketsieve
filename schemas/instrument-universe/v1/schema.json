{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:instrument-universe:1.0.0",
  "title": "MarketSieve instrument universe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "universe_id", "market", "source_profile", "as_of", "instruments", "source_ids", "diagnostics"],
  "properties": {
    "schema": {"const": "instrument-universe/v1"},
    "universe_id": {"$ref": "#/$defs/digest"},
    "market": {"enum": ["jp", "us"]},
    "source_profile": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "instruments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instrument"}},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "diagnostics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "mic", "currency", "timezone", "instrument_type"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*$"},
        "mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "timezone": {"type": "string", "minLength": 1},
        "instrument_type": {"const": "equity"}
      }
    }
  }
}
