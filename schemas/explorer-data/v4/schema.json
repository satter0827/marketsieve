{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:explorer-data:4.0.0",
  "type": "object",
  "required": ["schema", "metadata", "renderer", "sections", "sources", "facets", "column_sets", "field_catalog", "views", "actions"],
  "properties": {
    "schema": {"const": "explorer-data/v4"},
    "metadata": {"type": "object", "required": ["object_type", "object_id", "title", "locale", "created_at", "source", "object_contract"]},
    "renderer": {"type": "object", "required": ["version"], "properties": {"version": {"const": "marketsieve-explorer/v4"}}, "additionalProperties": false},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "description"]}},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["path", "format"], "properties": {"path": {"type": "string", "pattern": "^[a-zA-Z0-9.-]+$"}, "format": {"enum": ["json", "jsonl"]}}, "additionalProperties": false}},
    "facets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "column_sets": {"type": "object", "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
    "field_catalog": {"type": "array", "items": {"type": "object", "required": ["name", "data_type", "unit", "definition"]}},
    "views": {"type": "array", "items": {"type": "object", "required": ["id", "section", "type", "title", "source", "fields", "unit", "period"]}},
    "actions": {"type": "object", "required": ["query", "compare", "research"], "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
