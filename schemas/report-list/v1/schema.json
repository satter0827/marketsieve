{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:report-list:1.0.0",
  "title": "MarketSieve decision report list",
  "type": "object",
  "required": ["schema_version", "reports"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["report_id", "session", "as_of"],
        "properties": {
          "report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "session": {"enum": ["jp_close", "us_close", "weekly"]},
          "as_of": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
