{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsieve:schema:market-matrix-comparison:1.0.0",
  "title": "MarketSieve stored matrix row comparison",
  "type": "object",
  "required": ["schema", "matrix_id", "fields", "rows"],
  "properties": {
    "schema": {"const": "market-matrix-comparison/v1"},
    "matrix_id": {"$ref": "#/$defs/digest"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrumentId": {"type": "string", "pattern": "^[A-Z0-9]{4}:[A-Z0-9][A-Z0-9.-]*$"},
    "missingReason": {
      "enum": [
        "benchmark_unavailable",
        "corporate_action_mismatch",
        "currency_mismatch",
        "field_absent",
        "financials_unavailable",
        "history_empty",
        "insufficient_history",
        "network_error",
        "not_applicable",
        "provider_error",
        "rate_limited",
        "stale_history",
        "symbol_not_found",
        "zero_denominator"
      ]
    },
    "row": {
      "type": "object",
      "required": ["instrument_id", "values", "missing"],
      "properties": {
        "instrument_id": {"$ref": "#/$defs/instrumentId"},
        "values": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "missing": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/missingReason"}
        }
      },
      "anyOf": [
        {"properties": {"values": {"minProperties": 1}}},
        {"properties": {"missing": {"minProperties": 1}}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
